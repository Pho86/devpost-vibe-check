GITHUB_TOKEN=ghp_your_token_here

PROJECTS_CSV=path/to/projects-export.csv
HACKATHON_URL=https://your-event.devpost.com

# Naive times are interpreted in HACKATHON_TZ (default America/Los_Angeles)
HACKATHON_TZ=America/Los_Angeles
HACKATHON_START=2026-10-03T12:00:00
HACKATHON_END=2026-10-04T12:00:00

# Optional
# CHECKIN_CSV=path/to/portal-data.csv
# GITHUB_WORKERS=6

# Optional Gemini second-pass (also pass --gemini on the CLI)
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash
